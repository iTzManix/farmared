# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit credentials (DB passwords, API keys, etc.)
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
!.env.example

# database credentials & config
db-config*.json
db-config*.ts
db-config*.js
**/database.config.*
**/credentials.*
*.dsn

# ODBC configuration
odbc.ini
odbcinst.ini
.odbc.ini

# SSL/TLS certificates
*.pem
*.key
*.crt
*.pfx
*.p12

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
